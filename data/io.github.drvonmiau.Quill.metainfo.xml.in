<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
	<id>io.github.drvonmiau.Quill</id>
	<metadata_license>CC0-1.0</metadata_license>
	<project_license>GPL-3.0-or-later</project_license>
	<name>Quill</name>
	<summary>Track the books you read</summary>
	<developer id="io.github.drvonmiau">
		<name>Daniel</name>
	</developer>
	<description>
	  <p>
	    Quill is a calm, offline-first reading tracker. Keep shelves for the
	    books you want to read, are reading, and have finished; rate them and
	    jot notes; and add titles in seconds by searching Open Library.
	  </p>
	  <p>Features:</p>
	  <ul>
	    <li>Read / Reading / To read / Abandoned shelves with a master–detail layout</li>
	    <li>Add books by searching Open Library or Google Books, or add them manually</li>
	    <li>Automatic cover art and summaries, with a manual "find cover online" option</li>
	    <li>Reading dates on a calendar that highlights the started→finished span, plus reading progress</li>
	    <li>Star ratings, per-book tags, and title/author/tag search</li>
	    <li>Import from an Openreads CSV export and export your library back to CSV</li>
	    <li>Light and dark themes that follow the system</li>
	  </ul>
	</description>
	<launchable type="desktop-id">io.github.drvonmiau.Quill.desktop</launchable>
	<content_rating type="oars-1.1"/>
	<branding>
		<color type="primary" scheme_preference="light">#d3efe9</color>
		<color type="primary" scheme_preference="dark">#173d38</color>
	</branding>
	<url type="homepage">https://github.com/DrVonMiau/quill</url>
	<url type="bugtracker">https://github.com/DrVonMiau/quill/issues</url>
	<url type="vcs-browser">https://github.com/DrVonMiau/quill</url>
	<screenshots>
		<screenshot type="default">
			<image>https://raw.githubusercontent.com/DrVonMiau/quill/main/data/screenshots/shelf.png</image>
			<caption>Your Read shelf, cover by cover</caption>
		</screenshot>
		<screenshot>
			<image>https://raw.githubusercontent.com/DrVonMiau/quill/main/data/screenshots/book.png</image>
			<caption>A book, with its reading details</caption>
		</screenshot>
		<screenshot>
			<image>https://raw.githubusercontent.com/DrVonMiau/quill/main/data/screenshots/search.png</image>
			<caption>Searching your library</caption>
		</screenshot>
	</screenshots>
	<requires>
		<display_length compare="ge">768</display_length>
	</requires>
	<supports>
		<control>keyboard</control>
		<control>pointing</control>
	</supports>
	<releases>
		<release version="1.0.0" date="2026-08-31">
			<description>
				<p>Quill reaches 1.0 — its first stable release.</p>
				<ul>
					<li>Four shelves — Read, Reading, To read and Abandoned — in a master–detail layout</li>
					<li>Add books from Open Library or Google Books, or by hand, with covers and summaries fetched for you</li>
					<li>Reading dates on a span-highlighting calendar, page progress, star ratings and per-book tags</li>
					<li>Import from an Openreads CSV export and export your library back out</li>
					<li>Window chrome follows your system icon theme; refreshed screenshots and documentation</li>
				</ul>
			</description>
		</release>
		<release version="0.2.0" date="2026-08-25">
			<description>
				<p>A big feature release.</p>
				<ul>
					<li>Master–detail layout with a floating info panel and an Abandoned shelf.</li>
					<li>Reading dates are captured automatically when you move a book to Reading or Read, editable on a calendar that highlights the whole reading span.</li>
					<li>Reading progress (current page) with a progress bar.</li>
					<li>Google Books as an alternative search backend, plus a manual add-book form.</li>
					<li>Per-book tags with a multi-tag editor; search now matches tags too.</li>
					<li>Import from an Openreads CSV and export your library to CSV.</li>
				</ul>
			</description>
		</release>
		<release version="0.1.0" date="2026-08-10">
			<description>
				<p>Initial release.</p>
			</description>
		</release>
	</releases>
</component>
