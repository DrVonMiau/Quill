<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="quill">
	<schema id="io.github.drvonmiau.Quill" path="/io/github/drvonmiau/Quill/">
		<key name="theme" type="s">
			<choices>
				<choice value="light"/>
				<choice value="dark"/>
				<choice value="system"/>
			</choices>
			<default>'system'</default>
			<summary>Color theme</summary>
			<description>Whether to use the light theme, the dark theme, or follow the system preference.</description>
		</key>
		<key name="window-width" type="i">
			<default>1100</default>
			<summary>Window width</summary>
		</key>
		<key name="window-height" type="i">
			<default>720</default>
			<summary>Window height</summary>
		</key>
		<key name="window-maximized" type="b">
			<default>false</default>
			<summary>Window maximized</summary>
		</key>
		<key name="last-shelf" type="s">
			<choices>
				<choice value="read"/>
				<choice value="reading"/>
				<choice value="want"/>
				<choice value="abandoned"/>
			</choices>
			<default>'reading'</default>
			<summary>Last active shelf</summary>
		</key>
		<key name="sort-books" type="s">
			<default>'finished'</default>
			<summary>Book sort order</summary>
		</key>
		<key name="search-source" type="s">
			<choices>
				<choice value="openlibrary"/>
				<choice value="googlebooks"/>
			</choices>
			<default>'openlibrary'</default>
			<summary>Book search backend</summary>
			<description>Which online catalogue the Add-a-Book search queries.</description>
		</key>
		<key name="cover-size" type="i">
			<range min="110" max="240"/>
			<default>140</default>
			<summary>Cover tile width</summary>
			<description>Width in pixels of the book cover tiles in the library grid.</description>
		</key>
	</schema>
</schemalist>
