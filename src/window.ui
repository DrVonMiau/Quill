<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>

  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">Add a Book…</attribute>
        <attribute name="action">win.add-book</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Preferences</attribute>
        <attribute name="action">win.preferences</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">About Quill</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>

  <template class="QuillWindow" parent="AdwApplicationWindow">
    <property name="default-width">1180</property>
    <property name="default-height">740</property>
    <property name="width-request">720</property>
    <property name="height-request">520</property>
    <property name="title">Quill</property>

    <property name="content">
      <object class="AdwToastOverlay" id="toast_overlay">
        <property name="child">
          <object class="GtkBox" id="root_box">
            <property name="orientation">vertical</property>
            <style>
              <class name="root-bg"/>
            </style>

            <!-- Row 1 — thin titlebar / drag handle. The cover-size slider +
                 menu group sits on the OPPOSITE side of the window controls
                 (reordered at runtime in _apply_titlebar_side). -->
            <child>
              <object class="GtkWindowHandle" id="titlebar_handle">
                <property name="height-request">48</property>
                <property name="child">
                  <object class="GtkBox" id="titlebar_box">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">6</property>
                    <property name="margin-start">16</property>
                    <property name="margin-end">8</property>
                    <property name="valign">center</property>
                    <child>
                      <object class="GtkWindowControls" id="wc_start">
                        <property name="side">start</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScale" id="cover_scale">
                        <property name="orientation">horizontal</property>
                        <property name="draw-value">false</property>
                        <property name="width-request">120</property>
                        <property name="valign">center</property>
                        <property name="tooltip-text" translatable="yes">Cover size</property>
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">110</property>
                            <property name="upper">200</property>
                            <property name="value">140</property>
                            <property name="step-increment">2</property>
                            <property name="page-increment">20</property>
                          </object>
                        </property>
                        <style>
                          <class name="cover-scale"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuButton" id="menu_button">
                        <property name="icon-name">open-menu-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Main Menu</property>
                        <property name="valign">center</property>
                        <property name="menu-model">primary_menu</property>
                        <property name="primary">true</property>
                        <style>
                          <class name="flat"/>
                          <class name="circular"/>
                          <class name="titlebar-icon"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="titlebar_spacer">
                        <property name="hexpand">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkWindowControls" id="wc_end">
                        <property name="side">end</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>

            <!-- Row 2 — navigation band on the grey desktop, aligned to the
                 paper: shelf tabs (left) / search entry, sort + search right. -->
            <child>
              <object class="GtkBox" id="nav_row">
                <property name="orientation">horizontal</property>
                <property name="spacing">8</property>
                <property name="margin-top">24</property>
                <property name="margin-bottom">18</property>
                <property name="valign">center</property>
                <child>
                  <object class="GtkStack" id="middle_stack">
                    <property name="hexpand">true</property>
                    <property name="valign">center</property>
                    <property name="transition-type">crossfade</property>
                    <property name="transition-duration">100</property>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">view</property>
                        <property name="child">
                          <object class="GtkBox" id="tabs_box">
                            <property name="orientation">horizontal</property>
                            <property name="halign">start</property>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <style>
                                  <class name="tab-group"/>
                                </style>
                                <child>
                                  <object class="GtkButton" id="tab_read">
                                    <property name="label" translatable="yes">Read</property>
                                    <style>
                                      <class name="flat"/>
                                      <class name="tab-btn"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="tab_reading">
                                    <property name="label" translatable="yes">Reading</property>
                                    <style>
                                      <class name="flat"/>
                                      <class name="tab-btn"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="tab_toread">
                                    <property name="label" translatable="yes">To read</property>
                                    <style>
                                      <class name="flat"/>
                                      <class name="tab-btn"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">search</property>
                        <property name="child">
                          <object class="GtkSearchEntry" id="search_entry">
                            <property name="placeholder-text" translatable="yes">Search your library</property>
                            <property name="hexpand">true</property>
                            <property name="valign">center</property>
                            <style>
                              <class name="search-entry"/>
                            </style>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="add_btn">
                    <property name="icon-name">list-add-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Add a book</property>
                    <property name="valign">center</property>
                    <style>
                      <class name="flat"/>
                      <class name="circular"/>
                      <class name="titlebar-icon"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkMenuButton" id="sort_btn">
                    <property name="icon-name">view-sort-descending-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Sort</property>
                    <property name="valign">center</property>
                    <style>
                      <class name="flat"/>
                      <class name="circular"/>
                      <class name="titlebar-icon"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkToggleButton" id="search_toggle_btn">
                    <property name="tooltip-text" translatable="yes">Search</property>
                    <property name="valign">center</property>
                    <style>
                      <class name="flat"/>
                      <class name="circular"/>
                      <class name="titlebar-icon"/>
                    </style>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">system-search-symbolic</property>
                        <property name="pixel-size">14</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

            <!-- Content: the paper library card + the floating info panel -->
            <child>
              <object class="GtkBox" id="content_row">
                <property name="orientation">horizontal</property>
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>

                <child>
                  <object class="GtkBox" id="paper">
                    <property name="orientation">vertical</property>
                    <property name="hexpand">true</property>
                    <property name="vexpand">true</property>
                    <style>
                      <class name="paper"/>
                    </style>
                    <child>
                      <object class="GtkStack" id="paper_stack">
                        <property name="vexpand">true</property>
                        <property name="hexpand">true</property>
                        <property name="transition-type">crossfade</property>
                        <property name="transition-duration">120</property>

                        <child>
                          <object class="GtkStackPage">
                            <property name="name">empty</property>
                            <property name="child">
                              <object class="AdwStatusPage" id="empty_page">
                                <property name="icon-name">quill-status-toread-symbolic</property>
                                <property name="title" translatable="yes">No Books Yet</property>
                                <property name="description" translatable="yes">Search Open Library to start your shelf.</property>
                                <property name="child">
                                  <object class="GtkButton" id="add_first_btn">
                                    <property name="label" translatable="yes">Add a Book…</property>
                                    <property name="halign">center</property>
                                    <property name="action-name">win.add-book</property>
                                    <style>
                                      <class name="pill"/>
                                      <class name="empty-cta"/>
                                    </style>
                                  </object>
                                </property>
                              </object>
                            </property>
                          </object>
                        </child>

                        <child>
                          <object class="GtkStackPage">
                            <property name="name">library</property>
                            <property name="child">
                              <object class="GtkScrolledWindow">
                                <property name="hscrollbar-policy">never</property>
                                <property name="child">
                                  <object class="GtkGridView" id="book_grid">
                                    <property name="min-columns">2</property>
                                    <property name="max-columns">12</property>
                                    <property name="margin-top">24</property>
                                    <property name="margin-bottom">24</property>
                                    <property name="margin-start">24</property>
                                    <property name="margin-end">24</property>
                                    <property name="valign">start</property>
                                    <style>
                                      <class name="card-grid"/>
                                    </style>
                                  </object>
                                </property>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- Floating info panel (revealed when a book is selected) -->
                <child>
                  <object class="GtkRevealer" id="info_revealer">
                    <property name="transition-type">slide-left</property>
                    <property name="transition-duration">160</property>
                    <property name="reveal-child">false</property>
                    <child>
                      <object class="GtkScrolledWindow" id="info_panel">
                        <property name="hscrollbar-policy">never</property>
                        <property name="width-request">300</property>
                        <style>
                          <class name="info-panel"/>
                        </style>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">16</property>
                            <property name="valign">start</property>

                            <child>
                              <object class="GtkBox" id="detail_cover_slot">
                                <property name="halign">center</property>
                                <property name="hexpand">true</property>
                              </object>
                            </child>

                            <child>
                              <object class="GtkBox" id="status_seg">
                                <property name="spacing">8</property>
                                <property name="height-request">44</property>
                                <style>
                                  <class name="status-seg"/>
                                </style>
                                <child>
                                  <object class="GtkButton" id="status_read_btn">
                                    <style>
                                      <class name="status-btn"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="status_reading_btn">
                                    <style>
                                      <class name="status-btn"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="status_toread_btn">
                                    <style>
                                      <class name="status-btn"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>

                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">16</property>
                                <property name="margin-top">6</property>
                                <style>
                                  <class name="details"/>
                                </style>

                                <child>
                                  <object class="GtkBox">
                                    <property name="spacing">12</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">Title</property>
                                        <property name="xalign">0</property>
                                        <style><class name="detail-key"/></style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="detail_title">
                                        <property name="hexpand">true</property>
                                        <property name="xalign">1</property>
                                        <property name="ellipsize">end</property>
                                        <style><class name="detail-val"/></style>
                                      </object>
                                    </child>
                                  </object>
                                </child>

                                <child>
                                  <object class="GtkBox">
                                    <property name="spacing">12</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">Author</property>
                                        <property name="xalign">0</property>
                                        <style><class name="detail-key"/></style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="detail_author">
                                        <property name="hexpand">true</property>
                                        <property name="xalign">1</property>
                                        <property name="ellipsize">end</property>
                                        <style><class name="detail-val"/></style>
                                      </object>
                                    </child>
                                  </object>
                                </child>

                                <child>
                                  <object class="GtkSeparator"><style><class name="detail-sep"/></style></object>
                                </child>

                                <child>
                                  <object class="GtkBox">
                                    <property name="spacing">12</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">Rating</property>
                                        <property name="xalign">0</property>
                                        <property name="valign">center</property>
                                        <style><class name="detail-key"/></style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox" id="detail_rating_box">
                                        <property name="hexpand">true</property>
                                        <property name="halign">end</property>
                                        <property name="spacing">2</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>

                                <child>
                                  <object class="GtkSeparator"><style><class name="detail-sep"/></style></object>
                                </child>

                                <child>
                                  <object class="GtkBox">
                                    <property name="spacing">12</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">Date</property>
                                        <property name="xalign">0</property>
                                        <style><class name="detail-key"/></style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="detail_date">
                                        <property name="hexpand">true</property>
                                        <property name="xalign">1</property>
                                        <property name="ellipsize">end</property>
                                        <style><class name="detail-val"/></style>
                                      </object>
                                    </child>
                                  </object>
                                </child>

                                <child>
                                  <object class="GtkBox">
                                    <property name="spacing">12</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">Pages</property>
                                        <property name="xalign">0</property>
                                        <style><class name="detail-key"/></style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="detail_pages">
                                        <property name="hexpand">true</property>
                                        <property name="xalign">1</property>
                                        <style><class name="detail-val"/></style>
                                      </object>
                                    </child>
                                  </object>
                                </child>

                                <child>
                                  <object class="GtkSeparator"><style><class name="detail-sep"/></style></object>
                                </child>

                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Summary</property>
                                    <property name="xalign">0</property>
                                    <style><class name="detail-key"/></style>
                                  </object>
                                </child>

                                <child>
                                  <object class="GtkTextView" id="detail_notes">
                                    <property name="wrap-mode">word-char</property>
                                    <property name="accepts-tab">false</property>
                                    <property name="top-margin">8</property>
                                    <property name="bottom-margin">8</property>
                                    <property name="left-margin">10</property>
                                    <property name="right-margin">10</property>
                                    <property name="height-request">96</property>
                                    <style><class name="notes"/></style>
                                  </object>
                                </child>

                                <child>
                                  <object class="GtkButton" id="detail_remove_btn">
                                    <property name="label" translatable="yes">Remove from library</property>
                                    <property name="halign">start</property>
                                    <property name="margin-top">2</property>
                                    <style>
                                      <class name="flat"/>
                                      <class name="remove-link"/>
                                    </style>
                                  </object>
                                </child>

                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>

              </object>
            </child>

          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
